{
  "rules": {
    "usuarios": {
      "$chave": {
        "nome": { ".read": "auth != null" },
        "id": { ".read": "auth != null", ".validate": "newData.isString() && newData.val().length <= 40" },
        ".write": "auth != null && ((!newData.exists() && data.child('dono').val() === auth.uid) || (newData.child('dono').val() === auth.uid && (!data.exists() || data.child('dono').val() === auth.uid || data.child('segredo').val() === newData.child('segredo').val())))",
        ".validate": "newData.hasChildren(['dono', 'segredo', 'nome']) && newData.child('segredo').isString() && newData.child('segredo').val().length === 64 && newData.child('nome').isString() && newData.child('nome').val().length > 0 && newData.child('nome').val().length <= 20"
      }
    },
    "historicos": {
      "$cofre": {
        ".read": "auth != null && $cofre.matches(/^[0-9a-f]{64}$/)",
        "perfil": {
          ".write": "auth != null && $cofre.matches(/^[0-9a-f]{64}$/)",
          ".validate": "newData.hasChildren(['nome', 'chave']) && newData.child('nome').isString() && newData.child('nome').val().length > 0 && newData.child('nome').val().length <= 20 && newData.child('chave').isString() && newData.child('chave').val().length <= 40"
        },
        "$id": {
          ".write": "auth != null && $cofre.matches(/^[0-9a-f]{64}$/) && $id.matches(/^[0-9]{1,16}$/)",
          ".validate": "newData.child('excluida').val() === true || (newData.hasChildren(['id', 'data', 'total']) && newData.child('data').isString() && newData.child('total').isNumber())"
        }
      }
    },
    "identidades": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && newData.exists() && newData.child('chave').isString() && root.child('usuarios').child(newData.child('chave').val()).child('dono').val() === auth.uid && root.child('usuarios').child(newData.child('chave').val()).child('id').val() === $id",
        ".validate": "newData.hasChildren(['nome', 'chave']) && newData.child('chave').val().length <= 40 && newData.child('nome').val() === root.child('usuarios').child(newData.child('chave').val()).child('nome').val()",
        "antigos": { "$chave": { ".validate": "newData.val() === true" } }
      }
    },
    "ranking": {
      ".read": "auth != null",
      "$chave": {
        ".write": "auth != null && root.child('usuarios').child($chave).child('dono').val() === auth.uid",
        ".validate": "newData.hasChildren(['nome', 'total', 'data']) && newData.child('nome').isString() && newData.child('nome').val().length > 0 && newData.child('nome').val().length <= 20 && newData.child('total').isNumber() && newData.child('total').val() >= 0 && newData.child('total').val() <= 1948 && newData.child('data').isString() && newData.child('data').val().length <= 30"
      }
    },
    "fotos": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && newData.exists() && newData.child('chave').isString() && root.child('usuarios').child(newData.child('chave').val()).child('dono').val() === auth.uid && root.child('usuarios').child(newData.child('chave').val()).child('id').val() === $id",
        ".validate": "newData.hasChildren(['chave', 'img', 'em']) && newData.child('img').isString() && newData.child('img').val().length <= 20000 && (newData.child('img').val() === '' || newData.child('img').val().beginsWith('data:image/jpeg;base64,')) && newData.child('em').isNumber()"
      }
    },
    "abertas": {
      ".read": "auth != null",
      "$codigo": {
        ".write": "auth != null && $codigo.matches(/^[0-9]{5}$/) && ((newData.val() === true && root.child('partidas').child($codigo).child('criador').val() === auth.uid) || (!newData.exists() && (!root.child('partidas').child($codigo).child('criador').exists() || (root.child('partidas').child($codigo).child('criadaEm').isNumber() && root.child('partidas').child($codigo).child('criadaEm').val() < now - 259200000))))"
      }
    },
    "partidas": {
      "$codigo": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && data.child('criadaEm').isNumber() && data.child('criadaEm').val() < now - 259200000",
        "criador": { ".write": "auth != null && newData.val() === auth.uid && (!data.exists() || (data.parent().child('jogadores').child(data.val()).child('chave').isString() && root.child('usuarios').child(data.parent().child('jogadores').child(data.val()).child('chave').val()).child('dono').val() === auth.uid))" },
        "criadaEm": { ".write": "auth != null && !data.exists()" },
        "iniciada": { ".write": "auth != null && data.parent().child('criador').val() === auth.uid", ".validate": "newData.isBoolean()" },
        "revelada": { ".write": "auth != null && newData.val() === true" },
        "encerrada": { ".write": "auth != null && newData.val() === true && data.parent().child('criador').val() === auth.uid" },
        "nomes": {
          "$chave": { ".write": "auth != null && (!data.exists() || data.val() === auth.uid || root.child('usuarios').child($chave).child('dono').val() === auth.uid) && (!newData.exists() || (newData.val() === auth.uid && root.child('usuarios').child($chave).child('dono').val() === auth.uid))" }
        },
        "jogadores": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChild('nome')",
            "nome": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
            "casas": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 52 && newData.val() % 1 === 0" },
            "base": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000 && newData.val() % 1 === 0" },
            "pulos": { "$outro": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000 && newData.val() % 1 === 0" } }
          }
        }
      }
    }
  }
}
